#!/usr/bin/env bash
# Yubie Graphify post-commit hook — non-blocking incremental update.

set -euo pipefail

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "${REPO_ROOT}"

if ! command -v graphify >/dev/null 2>&1; then
  exit 0
fi

if [[ ! -f "graphify-out/graph.json" ]]; then
  exit 0
fi

GIT_DIR="${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}"
[[ -d "${GIT_DIR}/rebase-merge" || -d "${GIT_DIR}/rebase-apply" ]] && exit 0
[[ -f "${GIT_DIR}/MERGE_HEAD" || -f "${GIT_DIR}/CHERRY_PICK_HEAD" ]] && exit 0

CHANGED="$(git diff --name-only HEAD~1 HEAD 2>/dev/null || true)"
if [[ -z "${CHANGED}" ]]; then
  exit 0
fi

_NON_GRAPH="$(echo "${CHANGED}" | grep -v '^graphify-out/' | grep -v '^\.graphify/' || true)"
if [[ -z "${_NON_GRAPH}" ]]; then
  exit 0
fi

mkdir -p "${REPO_ROOT}/.graphify/logs"
nohup bash "${REPO_ROOT}/scripts/graphify/update.sh" --hook >> "${REPO_ROOT}/.graphify/logs/hooks.log" 2>&1 &
exit 0
