// Cloudflare Workers deployment contract for the Yubie web runtime (PRODUCTION).
//
// Same verified Vinext worker bundle as staging (scripts/build-verified.sh);
// this file only describes the production deployment:
//
//   npm run build                                  # in apps/web — produces dist/
//   npx wrangler deploy -c wrangler.prod.jsonc
//   npx wrangler secret put API_PROXY_TOKEN -c wrangler.prod.jsonc
//
// Build-time profile note: the worker bundle must be built with
// NEXT_PUBLIC_YUBIE_LAUNCH_PROFILE=DIRECT_COMMERCE_PRODUCTION so customer
// routes render; the static catalog export path rejects that profile by design.
//
// Existing production custom domains and ASSETS binding must be preserved.
// Rollback uses a compatible Worker version; never restore apex DNS to Vercel.
// Build under DIRECT_COMMERCE_PRODUCTION and retain the complete Vinext assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yubie-web-production",
  "main": "dist/server/index.js",
  // Static assets (JS/CSS/media emitted by the vinext build) are served by
  // the Workers Static Assets binding BEFORE the worker script — the vinext
  // server reads the same files through env.ASSETS. Without this block the
  // deployed worker serves HTML that references hashed assets it cannot
  // deliver (404 → hydration breaks on every client-rendered page).
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "YUBIE_API_ORIGIN": "https://api.yubiefood.com"
  },
  // Existing apex and candidate custom domains; no DNS cutover is required.
  "routes": [
    { "pattern": "next.yubiefood.com", "custom_domain": true },
    { "pattern": "yubiefood.com", "custom_domain": true }
  ]
  // Secrets (set via `wrangler secret put`, never committed):
  //   API_PROXY_TOKEN — authenticates the web→api server hop (production value).
}
