{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "YubieSemanticExtraction",
  "type": "object",
  "required": [
    "document",
    "document_type",
    "summary",
    "entities",
    "relationships",
    "decisions",
    "constraints",
    "code_references",
    "security_boundaries",
    "data_authorities",
    "operational_dependencies"
  ],
  "properties": {
    "document": { "type": "string", "minLength": 1 },
    "document_type": {
      "type": "string",
      "enum": ["ADR", "RUNBOOK", "ARCHITECTURE", "PHASE", "PLAN", "ACCEPTANCE", "OTHER"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": [
              "service",
              "package",
              "database",
              "provider",
              "queue",
              "endpoint",
              "policy",
              "decision",
              "phase",
              "system"
            ]
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "relationship", "target", "evidence"],
        "properties": {
          "source": { "type": "string" },
          "relationship": { "type": "string" },
          "target": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "decisions": { "type": "array" },
    "constraints": { "type": "array" },
    "code_references": { "type": "array", "items": { "type": "string" } },
    "security_boundaries": { "type": "array", "items": { "type": "string" } },
    "data_authorities": { "type": "array", "items": { "type": "string" } },
    "operational_dependencies": { "type": "array", "items": { "type": "string" } }
  }
}
