# Production environment contract — 2026-10-24 release (ADR-013).
# Copy to /etc/yubie/production.env on the VPS (root-owned, mode 0600).
# Values are operator-supplied; nothing here is a default secret.
#
# Initial production posture: DIRECT_COMMERCE_PRODUCTION launch profile with
# COMMERCE_PROVIDER=preview (honest preview checkout, no live money) until the
# ADR-013 activation gates pass. Support is explicitly disabled (WhatsApp
# deferred); payment reconciliation runs without it.

YUBIE_ENV=production
RELEASE_SHA=<full-40-char-sha>
YUBIE_LAUNCH_PROFILE=DIRECT_COMMERCE_PRODUCTION

# PostgreSQL (isolated production instance; own credentials/volumes/backups)
POSTGRES_USER=yubie_prod
POSTGRES_PASSWORD=<generated>
POSTGRES_DB=yubie
DATABASE_URL=postgresql://yubie_prod:<generated>@postgres:5432/yubie

# Commerce (preview until ADR-013 gates pass; then ipaymu + IPAYMU_ENV=production)
COMMERCE_PROVIDER=preview
# Initial deployment is NONCHARGEABLE and fail-closed: new payable sessions
# refused at the door. Flip to enabled ONLY with authorized chargeable
# operation (ROLLBACK.md R1 is the incident lever in the opposite direction).
YUBIE_CHECKOUT_ADMISSION=disabled
INVENTORY_MODE=lots
PURCHASE_OPTIONS_SOURCE=database
# Shipping requires a current database approval with explicit city coverage.
SHIPPING_POLICY=
# Release tooling pins these to full immutable GHCR digests.
YUBIE_API_IMAGE=ghcr.io/yubiefood-id/yubie-api@sha256:<reviewed-api-digest>
YUBIE_WORKER_IMAGE=ghcr.io/yubiefood-id/yubie-worker@sha256:<reviewed-worker-digest>
APP_ORIGIN=https://yubiefood.com

# iPaymu (fill ONLY at authorized live activation; production pair must be ROTATED)
IPAYMU_ENV=
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_API_BASE_URL=
IPAYMU_NOTIFY_URL=https://api.yubiefood.com/v1/webhooks/ipaymu

# Web→api hop trust + ops token
API_PROXY_TOKEN=<generated>
OPS_API_TOKEN=<generated>

# Identity: Google sign-in (public client id); phone OTP off until SMSGATE provisioned
GOOGLE_CLIENT_ID=<public-client-id>
OTP_PROVIDER=disabled
OTP_HASH_SECRET=
OTP_DELIVERY_ENCRYPTION_KEY=
OTP_ALLOWED_COUNTRIES=ID
TURNSTILE_SECRET_KEY=
SMSGATE_BASE_URL=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_DEVICE_ID=
SMSGATE_SIM_NUMBER=1

# Delivery Maps (off until GOOGLE_MAPS_SERVER_KEY provisioned)
MAPS_PROVIDER=disabled
GOOGLE_MAPS_SERVER_KEY=

# Support: explicitly disabled (WhatsApp deferred; Zammad production untouched)
SUPPORT_PROVIDER=disabled
BOT_ENGINE=deterministic

# Shipping execution (ADR-014). Default disabled: no quotes, no bookings;
# inbound webhooks/reconciliation still run. Flip modes only per ADR-014 gates.
SHIPPING_EXECUTION_MODE=disabled
SHIPPING_PROVIDER=none
# Fill ONLY at authorized activation; sandbox keys are refused in production.
BITESHIP_ENV=
BITESHIP_API_KEY=
BITESHIP_API_BASE_URL=https://api.biteship.com
BITESHIP_WEBHOOK_SECRET=
BITESHIP_WEBHOOK_SECRET_HEADER=x-biteship-secret
# Required when SHIPPING_EXECUTION_MODE=pilot (bounded real-charge pilot).
SHIPPING_PILOT_MAX_BOOKINGS=
SHIPPING_PILOT_BUDGET_IDR=
