# Yubie core-VPS staging environment — NO REAL SECRETS IN THIS FILE.
# Copy to /etc/yubie/staging.env (root-only) on the staging VPS and fill the
# real values; then verify offline before deploying:
#   set -a; source /etc/yubie/staging.env; set +a; npm run config:validate
# Deploy (from the repo root):
#   docker compose --env-file /etc/yubie/staging.env -f infrastructure/docker-compose.prod.yml pull
#   docker compose --env-file /etc/yubie/staging.env -f infrastructure/docker-compose.prod.yml run --rm migrate
#   docker compose --env-file /etc/yubie/staging.env -f infrastructure/docker-compose.prod.yml up -d --remove-orphans
#
# The compose file enforces per-service least privilege: a variable listed
# here reaches ONLY the services whose environment block names it.

# --- release identity -------------------------------------------------------
# Full commit SHA of the images published by the release-candidate workflow.
RELEASE_SHA=replace_with_full_commit_sha

# --- environment ------------------------------------------------------------
YUBIE_ENV=staging

# --- database (core VPS only; never internet-published) ---------------------
POSTGRES_USER=yubie
POSTGRES_PASSWORD=replace_with_generated_password
POSTGRES_DB=yubie
# Inside the compose network the api/worker/bot reach postgres by service name.
DATABASE_URL=postgresql://yubie:replace_with_generated_password@postgres:5432/yubie

# --- api service --------------------------------------------------------------
APP_ORIGIN=https://staging.yubie.id
COMMERCE_PROVIDER=xendit
INVENTORY_MODE=lots
PURCHASE_OPTIONS_SOURCE=database
SHIPPING_POLICY=free_promotional
# Xendit TEST-mode only. LIVE IS PROHIBITED until the ADR-012 sandbox matrix
# passes against real TEST credentials.
XENDIT_SECRET_KEY=xnd_test_development_replace_me
XENDIT_WEBHOOK_TOKEN=replace_with_xendit_callback_verification_token
XENDIT_BUSINESS_ID=replace_with_xendit_business_id
# Leave empty for the official API endpoint.
XENDIT_API_BASE_URL=
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
# Shared secret with the web runtime's /api/* proxy hop (server-side only).
API_PROXY_TOKEN=replace_with_generated_proxy_token
# Bearer token for /ops/* endpoints (required outside local environments).
OPS_API_TOKEN=replace_with_generated_ops_token

# --- worker service -----------------------------------------------------------
SUPPORT_PROVIDER=zammad
BOT_ENGINE=deterministic
WORKER_METRICS_ENABLED=true
ZAMMAD_BASE_URL=https://support-staging.yubie.id
ZAMMAD_API_TOKEN=replace_with_zammad_api_token
ZAMMAD_WHATSAPP_ARTICLE_TYPE=replace_with_discovered_article_type
ZAMMAD_GROUP_BOT_QUEUE=replace_with_discovered_group_id
ZAMMAD_GROUP_CUSTOMER_SUPPORT=replace_with_discovered_group_id
ZAMMAD_GROUP_SALES_PARTNERSHIP=replace_with_discovered_group_id
ZAMMAD_GROUP_FOOD_SAFETY=replace_with_discovered_group_id
ZAMMAD_PRIORITY_HIGH=replace_with_discovered_priority_id

# --- bot service (webhook verification only — no Zammad API token here) -------
ZAMMAD_WEBHOOK_SECRET=replace_with_zammad_webhook_secret
ZAMMAD_WEBHOOK_BEARER=
# Chatwoot rollback path only; leave empty under Zammad.
CHATWOOT_AGENTBOT_SECRET=

# --- synthetic inventory lots (staging sellability) ---------------------------
# Direct commerce is lot-gated: seed released lots BEFORE enabling checkout.
# Example per SKU (run once against the staging database):
#   INSERT INTO inventory_lots (id, product_id, size_id, lot_code,
#     quantity_on_hand, expiry_date, status, released_at, release_reason,
#     created_at, updated_at)
#   VALUES ('lot_stg_flour_250_1', 'flour', '250g', 'STG-FL250-1', 100,
#     DATE '2027-06-30', 'released', NOW(), 'synthetic-staging-lot', NOW(), NOW());
# Repeat for every sellable SKU (flour/250g, flour/1kg, shake/sachet,
# shake/pack-7, ppang/mini, ppang/maxi, ppang/mini-pack-5, mie/single,
# mie/pack-3). FEFO consumes the earliest-expiry lot first.
