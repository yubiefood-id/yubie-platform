# Isolated iPaymu sandbox acceptance environment (ADR-013 gate 1).
# Copy to /etc/yubie/sandbox.env on the VPS (root-owned, mode 0600).
# Deploy as its OWN compose project (-p yubie-sandbox) so it shares NOTHING
# with yubie-prod or the Zammad stack: own DB volume, own credentials,
# own hostname. Rotated SANDBOX credentials only — production pairs are
# forbidden here, and the 2026-10-19 pasted pair is burned.
#
# Callback hostname requires DNS: api-sandbox.yubiefood.com → VPS (blocker B5),
# Caddy route appended like api.yubiefood.com (ROLLBACK.md R4 pattern).

YUBIE_ENV=staging
RELEASE_SHA=<full-40-char-sha>
YUBIE_LAUNCH_PROFILE=DIRECT_COMMERCE_SANDBOX

POSTGRES_USER=yubie_sandbox
POSTGRES_PASSWORD=<generated>
POSTGRES_DB=yubie
DATABASE_URL=postgresql://yubie_sandbox:<generated>@postgres:5432/yubie

# Real provider against the iPaymu SANDBOX origin only
COMMERCE_PROVIDER=ipaymu
IPAYMU_ENV=sandbox
IPAYMU_VA=<rotated-sandbox-va>
IPAYMU_API_KEY=<rotated-sandbox-api-key>
IPAYMU_API_BASE_URL=https://sandbox.ipaymu.com
IPAYMU_NOTIFY_URL=https://api-sandbox.yubiefood.com/v1/webhooks/ipaymu
INVENTORY_MODE=lots
PURCHASE_OPTIONS_SOURCE=database
SHIPPING_POLICY=free_promotional
APP_ORIGIN=https://api-sandbox.yubiefood.com
API_PROXY_TOKEN=<generated>
OPS_API_TOKEN=<generated>

# Support off: this stack exists for payment acceptance only
SUPPORT_PROVIDER=disabled
BOT_ENGINE=deterministic
