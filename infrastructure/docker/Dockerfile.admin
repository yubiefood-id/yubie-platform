FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY apps/worker/package.json ./apps/worker/package.json
COPY apps/bot/package.json ./apps/bot/package.json
COPY packages ./packages
COPY apps/admin ./apps/admin
RUN npm ci
RUN npm run build --workspace @yubie/config \
  && npm run build --workspace @yubie/domain \
  && npm run build --workspace @yubie/validation \
  && npm run build --workspace @yubie/application \
  && npm run build --workspace @yubie/integrations \
  && npm run build --workspace @yubie/persistence \
  && npm run build --workspace @yubie/ui \
  && npm run build --workspace @yubie/admin
RUN npm prune --omit=dev

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
WORKDIR /app
ENV NODE_ENV=production ADMIN_HOST=0.0.0.0 ADMIN_PORT=4174
RUN addgroup -S yubie && adduser -S yubie -G yubie \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --from=build /app /app
USER yubie
EXPOSE 4174
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -qO- http://127.0.0.1:4174/healthz || exit 1
CMD ["node", "apps/admin/dist/runtime.js"]
