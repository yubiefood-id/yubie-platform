FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps/api ./apps/api
RUN npm ci
RUN npm run build --workspace @yubie/domain \
  && npm run build --workspace @yubie/validation \
  && npm run build --workspace @yubie/application \
  && npm run build --workspace @yubie/integrations \
  && npm run build --workspace @yubie/persistence \
  && npm run build --workspace @yubie/commerce \
  && npm run build --workspace @yubie/api

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S yubie && adduser -S yubie -G yubie
COPY --from=build /app /app
USER yubie
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -qO- http://127.0.0.1:8787/healthz || exit 1
CMD ["node", "apps/api/dist/server.js"]
