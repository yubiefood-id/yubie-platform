FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker
RUN npm ci
RUN npm run build --workspace @yubie/config \
  && npm run build --workspace @yubie/domain \
  && npm run build --workspace @yubie/application \
  && npm run build --workspace @yubie/integrations \
  && npm run build --workspace @yubie/assistant \
  && npm run build --workspace @yubie/persistence \
  && npm run build --workspace @yubie/worker
RUN npm prune --omit=dev

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S yubie \
  && adduser -S yubie -G yubie \
  && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
COPY --from=build /app /app
USER yubie
CMD ["node", "apps/worker/dist/index.js"]
