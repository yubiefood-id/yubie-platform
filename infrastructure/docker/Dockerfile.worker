FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker
RUN npm ci
RUN npm run build --workspace @yubie/domain \
  && npm run build --workspace @yubie/application \
  && npm run build --workspace @yubie/integrations \
  && npm run build --workspace @yubie/persistence \
  && npm run build --workspace @yubie/worker

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S yubie && adduser -S yubie -G yubie
COPY --from=build /app /app
USER yubie
CMD ["node", "apps/worker/dist/index.js"]
