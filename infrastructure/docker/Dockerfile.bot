FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps/bot ./apps/bot
RUN npm ci
RUN npm run build --workspace @yubie/domain \
  && npm run build --workspace @yubie/integrations \
  && npm run build --workspace @yubie/persistence \
  && npm run build --workspace @yubie/bot

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/bot ./apps/bot
EXPOSE 8788
CMD ["node", "apps/bot/dist/server.js"]
