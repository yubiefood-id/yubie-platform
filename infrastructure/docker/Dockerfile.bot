FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages ./packages
COPY apps/bot ./apps/bot
RUN npm ci
RUN npm run build --workspace @yubie/config \
  && npm run build --workspace @yubie/domain \
  && npm run build --workspace @yubie/application \
  && npm run build --workspace @yubie/integrations \
  && npm run build --workspace @yubie/persistence \
  && npm run build --workspace @yubie/bot

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S yubie && adduser -S yubie -G yubie
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/bot ./apps/bot
USER yubie
EXPOSE 8788
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -qO- http://127.0.0.1:8788/healthz || exit 1
CMD ["node", "apps/bot/dist/server.js"]
