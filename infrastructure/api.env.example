# Non-secret local configuration contract.
# Copy to a local ignored env file. Production values live outside Git.
#
# Fail-closed contract (packages/config):
# - development/test may explicitly use SUPPORT_PROVIDER=fake.
# - staging/production with SUPPORT_PROVIDER=zammad require every ZAMMAD_*
#   value below; missing values stop startup and readiness instead of
#   falling back to fake providers or placeholder routing IDs.
# - Fixture routing IDs (1-4) are for local development and tests only.
#   Never use them as staging/production values. Discover real IDs from the
#   Zammad instance (npm run zammad:provision) and set them explicitly.

PORT=8787
YUBIE_ENV=development

# Current direct commerce is preview/deferred by ADR-004.
COMMERCE_PROVIDER=preview

# Target persistence/worker phases.
DATABASE_URL=postgresql://yubie:yubie_local@127.0.0.1:5432/yubie_dev
WORKER_ENABLED=true

# Local provider modes. Disabled/fake providers require no production secrets.
CHAT_PROVIDER=fake
SUPPORT_PROVIDER=fake

# Zammad (required whenever SUPPORT_PROVIDER=zammad; validated fail-closed).
# Classification: BASE_URL/TOKEN per environment; see
# docs/production/runbooks/zammad.md for the staging/production table.
ZAMMAD_BASE_URL=https://support-staging.yubie.id
ZAMMAD_API_TOKEN=
ZAMMAD_WEBHOOK_SECRET=
ZAMMAD_WEBHOOK_BEARER=
# WhatsApp article type is DISCOVERED from the real Zammad instance.
# Empty here: development falls back to the local default ("whatsapp");
# staging/production MUST set the discovered value or startup fails.
ZAMMAD_WHATSAPP_ARTICLE_TYPE=
CRM_PROVIDER=fake
ASSISTANT_PROVIDER=fake
BOT_ENGINE=deterministic
# Zammad routing IDs are DISCOVERED from the real Zammad instance.
# Unset here: development falls back to documented fixture IDs (1-4);
# staging/production MUST set every ID explicitly or startup fails.
ZAMMAD_GROUP_BOT_QUEUE=
ZAMMAD_GROUP_CUSTOMER_SUPPORT=
ZAMMAD_GROUP_SALES_PARTNERSHIP=
ZAMMAD_GROUP_FOOD_SAFETY=
ZAMMAD_PRIORITY_HIGH=
YUBIE_BUSINESS_HOURS_JSON={"timezone":"Asia/Jakarta","openHour":9,"openMinute":0,"closeHour":17,"closeMinute":0,"weekdays":[1,2,3,4,5]}
MARKETPLACE_SHOPEE_PROVIDER=static
MARKETPLACE_TOKOPEDIA_PROVIDER=static

# Non-secret local origins.
YUBIE_WEB_ORIGIN=http://localhost:5173
YUBIE_API_ORIGIN=http://localhost:8787

# Real provider credentials/tokens are intentionally omitted from this file.
