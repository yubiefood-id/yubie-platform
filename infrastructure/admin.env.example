# Secret-free contract; supply values in an operator-managed 0600 file.
# Private production access uses an SSH tunnel and a trusted localhost TLS CA.
ADMIN_ORIGIN=https://localhost:4174
ADMIN_GOOGLE_CLIENT_ID=
ADMIN_SESSION_SECRET=
# Staff grants are approved named Google subjects in PostgreSQL, never this file.
ADMIN_WRITES_ENABLED=false
DATABASE_URL=
YUBIE_ENV=production
YUBIE_CHECKOUT_ADMISSION=disabled
RELEASE_SHA=
# The reviewed private Compose file injects these read-only certificate paths.
ADMIN_TLS_CERT_FILE=/run/secrets/admin.crt
ADMIN_TLS_KEY_FILE=/run/secrets/admin.key
# Optional one-time named-admin approval, root:10001 mode 0640 in the TLS mount.
# Leave empty to disable initial identity claiming; this never replaces staff RBAC.
ADMIN_INITIAL_STAFF_APPROVAL_FILE=
